    "smoke:workflow": "node --env-file-if-exists=.env scripts/workflow-smoke.mjs",
    "smoke:fitness": "node --env-file-if-exists=.env scripts/fitness-smoke.mjs",
    "smoke:domain-packages": "node --env-file-if-exists=.env scripts/domain-package-smoke.mjs",
