# Local development values. Copy to .env and replace every change-me value.
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-value
MONGODB_URI=mongodb://127.0.0.1:27017/brainy
FIREBASE_PROJECT_ID=brainy-6d65c
# Optional service account for reminders by push notification.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional comma-separated web origins for production.
CORS_ORIGIN=
# Large files: any S3-compatible storage (scripts/dev-local.mjs starts VersityGW locally).
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=brainy-large-files
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
# Optional e-mail reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Hosting. On Vercel (VERCEL is set there) background processing, data sources, large files and
# pictures/videos/sound/PDF files ("mediaFiles") are frozen, attachments are limited to 3 MiB per entry,
# and reminders are frozen unless CRON_SECRET is set (an outside scheduler then calls GET /cron/reminders
# with "Authorization: Bearer <CRON_SECRET>", 16+ characters, for example every minute from cron-job.org).
# List the frozen modules yourself to override ("" freezes none):
# BRAINY_FROZEN_MODULES=reminders,backgroundJobs,dataSources,largeFiles,mediaFiles
# BRAINY_MAX_ENTRY_ATTACHMENT_BYTES=3145728
CRON_SECRET=
